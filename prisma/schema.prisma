generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  logo       String?
  logoUrl    String?  @default("")
  brandColor String?  @default("")
  notifyEmail String? @default("")
  address    String?  @default("")
  city       String?  @default("")
  province   String?  @default("")
  postalCode String?  @default("")
  nif        String?  @default("")
  phone      String?  @default("")
  email      String?  @default("")
  website    String?  @default("")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users         User[]
  sedes         Sede[]
  professionals Professional[]
  plans         Plan[]
  holidays      Holiday[]
  subscription  Subscription?
  payments      Payment[]
  avisos        Aviso[]
  billClientes  BillCliente[]
  billCatalogo  BillCatalogo[]
  billRegistros BillRegistro[]
  billDiarioItems BillDiarioItem[]
  billConfig    BillConfig?
  billFacturaSeq BillFacturaSeq?
  auditLogs      AuditLog[]
  outbox         OutboxNotification[]
  alertRules     AlertRule[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  image         String?
  role          String   @default("USER") // SUPER_ADMIN | COMPANY_ADMIN | USER
  companyId     String?
  isActive      Boolean  @default(true)
  // When this user is a login for a Professional, links back to the Professional row.
  professionalId String?
  // CSV of granular permissions for USER role:
  //   view_diario, edit_diario
  //   view_mensual, edit_mensual
  //   view_sedes, edit_sedes
  //   view_own_only, view_assigned_sedes
  //   can_print, can_send
  permissions   String   @default("")
  // Optional 4-digit PIN (bcrypt-hashed). If set, login requires it; if null, login is open.
  pin           String?
  // ── Mensual view restrictions for this access (empty/false = no restriction beyond perms) ──
  // CSV of sede NAMES this access can see in the monthly view ("" = all sedes)
  allowedSedes  String   @default("")
  // CSV of professional ALIASES this access can see in the monthly view ("" = all)
  allowedPros   String   @default("")
  // Whether this access can see note indicators / note text on cards
  showNotes     Boolean  @default(true)
  // Whether this access can see vacation/absence (aviso) cards in the monthly view
  showVacaciones Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company?  @relation(fields: [companyId], references: [id])
}

model Subscription {
  id                String   @id @default(cuid())
  companyId         String   @unique
  planName          String   @default("BASIC") // BASIC | PRO | ENTERPRISE
  billingMethod     String   @default("MONTHLY") // MONTHLY | QUARTERLY | ANNUAL
  price             Float    @default(29.99)
  currency          String   @default("EUR")
  status            String   @default("TRIAL") // ACTIVE | PAST_DUE | CANCELLED | TRIAL
  trialEndsAt       DateTime?
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd  DateTime @default(now())
  maxProfessionals  Int      @default(5)
  maxSedes          Int      @default(3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  payments Payment[]
}

model Payment {
  id              String    @id @default(cuid())
  subscriptionId  String
  companyId       String
  amount          Float
  currency        String    @default("EUR")
  status          String     @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | OVERDUE
  paymentDate     DateTime?
  dueDate         DateTime
  method          String     @default("CARD") // CARD | TRANSFER | CASH
  invoiceNumber   String?
  concept         String?    @default("Suscripción mensual")
  taxRate         Float      @default(21.0)
  taxAmount       Float      @default(0)
  subtotal        Float      @default(0)
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime   @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  company      Company     @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
}

model Sede {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  city             String   @default("")
  province         String   @default("")
  task             String   @default("")
  email            String   @default("")
  phone            String   @default("")
  morningEnabled   Boolean  @default(true)
  afternoonEnabled Boolean  @default(true)
  color            String   @default("#3b82f6")
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plans   Plan[]
  avisos  Aviso[]

  @@index([companyId])
}

model Professional {
  id            String   @id @default(cuid())
  companyId     String
  firstName     String
  lastName      String
  alias         String
  type          String   @default("USER") // USER | ADMINISTRADOR
  category      String   @default("")
  username      String   @default("")
  email         String   @default("")
  phone         String   @default("")
  permissions   String   @default("") // comma-separated tasks (per in Firebase)
  assignedSedes String   @default("") // comma-separated sede names
  startDate     String   @default("") // ini date string (fini in Firebase)
  endDate       String   @default("INDEFINIDO")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  avisos  Aviso[]

  @@unique([companyId, alias])
  @@index([companyId])
}

model Plan {
  id                String   @id @default(cuid())
  companyId         String
  sedeId            String
  date              String   // YYYY-MM-DD
  turn              String   // MANANA | TARDE
  professionalAlias String
  notes             String   @default("") // free-form note shown when clicking the card
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sede    Sede    @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@unique([sedeId, date, turn])
  @@index([companyId, date])
  @@index([companyId, sedeId])
}

model Holiday {
  id        String   @id @default(cuid())
  companyId String
  province  String
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, province, date])
  @@index([companyId])
}

model Aviso {
  id              String   @id @default(cuid())
  companyId       String
  date            String   // YYYY-MM-DD
  professionalId  String?  // nullable: sede-level absences don't need a professional
  sedeId          String
  turn            String   // M | T
  reason          String   @default("") // BAJA | FORMACION | PERMISO | VACACIONES | custom
  note            String   @default("") // free-form note (e.g. added by voice)
  seenAt          DateTime? // marcado como visto (swipe en la app)
  createdAt       DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  sede         Sede          @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([professionalId])
  @@index([sedeId])
}

// ═══════════════════════════════════════════
// BILL by Método — Facturación independiente
// ═══════════════════════════════════════════

model BillCliente {
  id          String   @id @default(cuid())
  companyId   String
  nombre      String
  cif         String   @default("")
  dir         String   @default("")
  cp          String   @default("")
  ciudad      String   @default("")
  prov        String   @default("")
  mail        String   @default("")
  tel         String   @default("")
  customData  String   @default("") // JSON: custom field values
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  registros BillRegistro[]
  catalogo   BillCatalogo[]
  diarioItems BillDiarioItem[]

  @@index([companyId])
}

model BillCatalogo {
  id          String   @id @default(cuid())
  companyId   String
  clienteId   String?  // optional: client-specific pricing
  c1          String   // concept group
  c2          String   // concept service
  coste       Float    @default(0)
  inc         Float    @default(0) // increment %
  final       Float    @default(0) // final price
  customData  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cliente BillCliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clienteId])
}

model BillRegistro {
  id                String   @id @default(cuid())
  companyId         String
  fecha             String   // YYYY-MM-DD
  clienteId         String?  // FK
  cliente           String   @default("") // denormalized name
  c1                String   @default("") // concept group
  c2                String   @default("") // concept service
  cant              Int      @default(1)
  precioUnitario    Float    @default(0)
  obs               String   @default("")
  pasadoRegistro    Boolean  @default(false) // transferred from entrada
  facturado         Boolean  @default(false) // invoiced
  customData        String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clienteRel  BillCliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clienteId])
  @@index([fecha])
  @@index([pasadoRegistro])
  @@index([facturado])
}

model BillConfig {
  id                String   @id @default(cuid())
  companyId         String   @unique
  companyFullName   String   @default("")
  companyAddress    String   @default("")
  companyCity       String   @default("")
  companyProvince   String   @default("")
  companyCif        String   @default("")
  logo              String   @default("") // base64
  currency          String   @default("€")
  defaultIva        Float    @default(21)
  appName           String   @default("BILL by Método")
  appVersion        String   @default("v3.0")
  // Configurable section labels
  sectionEntrada    String   @default("ENTRADA")
  sectionRegistros  String   @default("REGISTROS")
  sectionClientes   String   @default("CLIENTES")
  sectionCatalogo   String   @default("CATÁLOGO")
  sectionFacturas   String   @default("FACTURAS")
  sectionBackup     String   @default("SEGURIDAD")
  // Configurable field labels (JSON strings)
  labelEntrada      String   @default("")
  labelCatalogo     String   @default("")
  labelRegistros    String   @default("")
  labelFacturas     String   @default("")
  labelClientes     String   @default("")
  // Visible fields (JSON arrays of FieldDef)
  fieldsEntrada     String   @default("")
  fieldsClientes    String   @default("")
  fieldsCatalogo    String   @default("")
  fieldsRegistros   String   @default("")
  fieldsFacturas    String   @default("")
  // Transfer settings
  transferMode      String   @default("auto") // "auto" or "manual"
  transferTime      String   @default("00:00")  // HH:mm for auto transfer
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model BillFacturaSeq {
  id        String   @id @default(cuid())
  companyId String   @unique
  seq       Int      @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════
// BILL — Diario → Facturación bridge
// Salida cumplida: completed Diario outputs ready for invoicing
// ═══════════════════════════════════════════
model BillDiarioItem {
  id              String   @id @default(cuid())
  companyId       String
  fecha           String   // YYYY-MM-DD
  sedeId          String?  // nullable: manual items may not have a sede
  sedeName        String   @default("") // denormalized for display
  professionalId  String?  // nullable
  professionalName String  @default("") // denormalized (alias or firstName+lastName)
  turn            String   @default("") // M | T | ""
  // Billing fields (filled when transferring to Registro)
  clienteId       String?  // FK to BillCliente
  cliente         String   @default("") // denormalized
  c1              String   @default("") // concept group (legacy/fallback)
  c2              String   @default("") // concept service (legacy/fallback)
  cant            Int      @default(1)
  precioUnitario  Float    @default(0)
  obs             String   @default("")
  // Lifecycle
  status          String   @default("CUMPLIDA") // CUMPLIDA | FACTURADA
  sourceType      String   @default("plan") // plan | manual
  sourceId        String?  // Plan.id when sourceType=plan
  registroId      String?  // BillRegistro.id when transferred (first one, for back-ref)
  facturadoAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clienteRel  BillCliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  lineas      BillDiarioLine[]

  @@index([companyId])
  @@index([fecha])
  @@index([sedeId])
  @@index([status])
  @@index([clienteId])
  @@unique([sourceType, sourceId])
}

// Each Diario item carries N líneas (each one references a catalog item)
// These líneas are what gets invoiced (1 line = 1 BillRegistro on transfer)
model BillDiarioLine {
  id            String   @id @default(cuid())
  diarioItemId  String
  companyId     String   // denormalized for fast filtering
  catalogoId    String?  // optional FK to BillCatalogo
  c1            String   @default("") // denormalized from catalog (or manual)
  c2            String   @default("") // denormalized from catalog (or manual)
  cant          Int      @default(1)
  precioUnitario Float   @default(0)
  obs           String   @default("")
  orden         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  diarioItem BillDiarioItem @relation(fields: [diarioItemId], references: [id], onDelete: Cascade)

  @@index([diarioItemId])
  @@index([companyId])
}

// ═══════════════════════════════════════════
// AUDITORÍA + COLA DE NOTIFICACIONES
// ═══════════════════════════════════════════

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  userName  String   @default("")
  action    String   // AVISO_CREATE | AVISO_DELETE | AVISO_SEEN | SEDE_... | LOGIN | ...
  entity    String   // Aviso | Sede | Professional | Company | ...
  entityId  String?
  detail    String   @default("")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model OutboxNotification {
  id        String    @id @default(cuid())
  companyId String
  channel   String    @default("email") // email | whatsapp
  target    String    // email o teléfono destino
  subject   String    @default("")
  body      String    @default("")
  status    String    @default("pending") // pending | sent | failed | manual
  error     String?   
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

// ═══════════════════════════════════════════
// AVISOS PROGRAMADOS — cuando en las NOTAS de una tarjeta/aviso aparece
// una palabra y faltan X días para su fecha → notificación push al móvil
// ═══════════════════════════════════════════

model AlertRule {
  id         String   @id @default(cuid())
  companyId  String
  keyword    String   // palabra o texto a buscar dentro de las notas
  daysBefore Int      @default(1) // avisar X días antes de la fecha de la tarjeta
  enabled    Boolean  @default(true)
  // ¿A QUIÉN le llega? CSV de User.id ("" = TODOS los usuarios de la empresa)
  recipients String   @default("")
  // ¿POR DÓNDE le llega? push (móvil) | email (correo) | both (ambos)
  channel    String   @default("both")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Suscripción push de un dispositivo (móvil/PC) para recibir las notificaciones
model PushSub {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  companyId String?  // empresa desde la que se activó (informativo)
  userId    String?  // usuario que activó ESTE dispositivo (para elegir a quién llega cada aviso)
  userAgent String   @default("")
  createdAt DateTime @default(now())
}

// Dedupe: un (entrada, regla, fecha objetivo) notifica una sola vez
model AlertSent {
  id         String   @id @default(cuid())
  source     String   // plan | aviso
  sourceId   String
  ruleId     String
  targetDate String   // YYYY-MM-DD de la tarjeta que disparó el aviso
  sentAt     DateTime @default(now())

  @@unique([source, sourceId, ruleId, targetDate])
  @@index([ruleId])
}

// Claves VAPID para Web Push (generadas una vez y guardadas en BD;
// así no hace falta configurar variables de entorno en Vercel)
model VapidKey {
  id         String @id @default("singleton")
  publicKey  String
  privateKey String
}

// Log de errores/fallos de activación de notificaciones (soporte remoto)
model PushErrorLog {
  id        String   @id @default(cuid())
  userId    String?
  device    String   @default("") // diagnóstico del dispositivo + userAgent
  error     String   @default("") // fallo real (name — message) o "OK"
  createdAt DateTime @default(now())
}
